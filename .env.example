# Which LLM the live assistant uses: groq / gemini (free), openai (ChatGPT, paid) or anthropic (Claude)
LLM_PROVIDER=groq

# Groq, free: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini, free: https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (needs paid credit)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Claude (used by app.py, and by the live assistant when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: override the model for the live assistant only
# LIVE_MODEL=gpt-4.1-mini

# tiny.en / base.en / small.en / medium.en  (bigger = more accurate, slower)
WHISPER_MODEL=base.en

# Fast model for the grey live text shown while someone is still talking
# PARTIAL_WHISPER_MODEL=tiny.en

# Speech-to-text for finished sentences: groq (default when GROQ_API_KEY is set — Whisper
# large-v3, ~0.4 s, best with accents/tech terms) or local (offline, uses WHISPER_MODEL)
# STT_PROVIDER=groq
# GROQ_STT_MODEL=whisper-large-v3
# Words to help recognition (project names, tech terms); replaces the built-in tech vocabulary
# WHISPER_PROMPT=Hello, hi. Interview about ScribeEMR, Dijkstra's algorithm, React, Node.js, Redis.
# Lower if quiet speech is missed, raise if background noise triggers transcripts
# MIN_SPEECH_LEVEL=0.0025
